# Copy this file to .env.integration before starting the local stack.
# Do not commit the copied file.

POSTGRES_USER=relay
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=new-api

REDIS_PASSWORD=replace-with-another-long-random-password
SESSION_SECRET=replace-with-a-long-random-session-secret

# This key must match the key in runtime/cpa/config.yaml and the New API channel.
CPA_API_KEY=replace-with-a-long-random-cpa-api-key

TZ=Asia/Shanghai

